# ==============================================================================
# 1. FIREBASE & FIRESTORE CONFIGURATION (For Vercel Production Deployment)
# ==============================================================================
# If left empty, the app automatically uses firebase-applet-config.json.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_DATABASE_ID=""

# ==============================================================================
# 2. GOOGLE DRIVE API & OAUTH 2.0 (Bulk Video Scanner & 1:N Folder Importer)
# ==============================================================================
# Optional Web OAuth Client ID override
VITE_GOOGLE_OAUTH_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"

# Optional fallback Google Drive API Key for scanning public folders without OAuth login
VITE_GOOGLE_DRIVE_API_KEY=""

# ==============================================================================
# 3. RUNTIME ENVIRONMENT VARIABLES
# ==============================================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
