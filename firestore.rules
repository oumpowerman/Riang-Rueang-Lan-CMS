rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check role safely
    function hasRole(role) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role) ||
        request.auth.token.role == role
      );
    }

    function isAdmin() {
      return hasRole('ADMIN') || (
        isAuthenticated() &&
        (request.auth.token.email == 'jengwaachanel@gmail.com' ||
          request.auth.token.email == 'dramaeveryday222@gmail.com') &&
        request.auth.token.email_verified == true
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Category Groups collection (Tier 0)
    match /category_groups/{groupId} {
      allow read, write: if true;
    }

    // Categories collection (Tier 1 & Tier 2)
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Sources collection (Flow B 1:N Long-form Livestream Sources SRC-XXXX)
    match /sources/{sourceId} {
      allow read, write: if true;
    }

    // Footages collection
    match /footages/{footageId} {
      allow read, write: if true;
    }

    // Episodes collection (Top 5 Master episodes)
    match /episodes/{episodeId} {
      allow read, write: if true;
    }

    // System settings collection
    match /system_settings/{settingId} {
      allow read, write: if true;
    }

    // Google Drive delta sync records collection
    match /drive_sync_records/{folderId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
